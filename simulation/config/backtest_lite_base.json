    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8099,
        "username": "sim",
        "password": "sim",
        "jwt_secret_key": "simulation-jwt-secret-key-32chars-min"
    },
    "bot_name": "sim-lite-player",
