{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": 30,
    "dry_run": true,
    "dry_run_wallet": 100,
    "db_url": "sqlite:///simulation/data/sim-lite-player.sqlite",
    "timeframe": "5m",
