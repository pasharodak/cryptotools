[Unit]
Description=CryptoTools shared signal engine (MultiStrategyRouter, no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
Environment=CT_SIGNAL_ONLY=1
ExecStart=/bin/bash -lc 'source /home/cryptotools/app/scripts/load_env.sh /home/cryptotools/.cryptotools.env && exec /home/cryptotools/app/.venv/bin/ctbot trade --config user_data/config_signal_engine.json --logfile user_data/logs/cryptotools-signal-engine.log'
Restart=on-failure
RestartSec=30
Slice=cryptotools.slice
MemoryHigh=1200M
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
