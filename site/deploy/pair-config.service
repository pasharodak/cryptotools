[Unit]
Description=CriptoTools pair whitelist admin API
After=network-online.target freqtrade.service freqtrade-strategy.service
Wants=network-online.target

[Service]
Type=simple
User=freqtrade
Group=freqtrade
WorkingDirectory=/home/freqtrade/freqtrade
Environment=FT_BASE=/home/freqtrade/freqtrade
Environment=FT_ENV=/home/freqtrade/.freqtrade.env
Environment=PAIR_CONFIG_HOST=127.0.0.1
Environment=PAIR_CONFIG_PORT=8090
ExecStart=/home/freqtrade/freqtrade/.venv/bin/python3 /home/freqtrade/freqtrade/scripts/pair_config_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
