[Unit]
Description=CriptoTools pair whitelist admin API
After=network-online.target cryptotools-finder.service cryptotools-strategy.service
Wants=network-online.target

[Service]
Type=simple
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
Environment=CT_BASE=/home/cryptotools/app
Environment=CT_ENV=/home/cryptotools/.cryptotools.env
Environment=PAIR_CONFIG_HOST=127.0.0.1
Environment=PAIR_CONFIG_PORT=8090
ExecStart=/home/cryptotools/app/.venv/bin/python3 /home/cryptotools/app/scripts/pair_config_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
