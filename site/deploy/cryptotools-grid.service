[Unit]
Description=CryptoTools grid bot (BB+ADX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
ExecStart=/bin/bash -lc 'source /home/cryptotools/app/scripts/load_env.sh /home/cryptotools/.cryptotools.env && exec /home/cryptotools/app/.venv/bin/ctbot trade --config user_data/config_grid.json --logfile user_data/logs/cryptotools-grid.log'
Restart=on-failure
RestartSec=30
Slice=cryptotools.slice
MemoryHigh=800M
MemoryMax=1000M

[Install]
WantedBy=multi-user.target
