[Unit]
Description=Reconcile open bot trades with Bybit positions
After=network-online.target cryptotools-finder.service cryptotools-strategy.service cryptotools-grid.service pair-config.service

[Service]
Type=oneshot
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
Environment=CT_BASE=/home/cryptotools/app
Environment=CT_ENV=/home/cryptotools/.cryptotools.env
ExecStart=/home/cryptotools/app/.venv/bin/python3 /home/cryptotools/app/scripts/reconcile_positions.py --fix --json
