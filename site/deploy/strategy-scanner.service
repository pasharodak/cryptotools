[Unit]
Description=Scan Bybit for strategy-suitable pairs and update Strategy bot whitelist
After=network-online.target freqtrade-strategy.service
Wants=network-online.target

[Service]
Type=oneshot
User=freqtrade
Group=freqtrade
WorkingDirectory=/home/freqtrade/freqtrade
Environment=FT_BASE=/home/freqtrade/freqtrade
Environment=FT_ENV=/home/freqtrade/.freqtrade.env
ExecStart=/bin/bash /home/freqtrade/freqtrade/scripts/run_strategy_scan.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
