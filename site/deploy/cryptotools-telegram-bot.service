[Unit]
Description=CryptoTools Telegram bot (Mini App + trade alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
Environment=CT_BASE=/home/cryptotools/app
Environment=CT_ENV=/home/cryptotools/.cryptotools.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/bin/bash -lc 'source /home/cryptotools/app/scripts/load_env.sh /home/cryptotools/.cryptotools.env && exec /home/cryptotools/app/.venv/bin/python /home/cryptotools/app/scripts/telegram_bot.py'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
