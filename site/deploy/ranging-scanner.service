[Unit]
Description=Scan Bybit for ranging pairs and update Grid bot whitelist
After=network-online.target cryptotools-grid.service
Wants=network-online.target

[Service]
Type=oneshot
User=cryptotools
Group=cryptotools
WorkingDirectory=/home/cryptotools/app
Environment=CT_BASE=/home/cryptotools/app
Environment=CT_ENV=/home/cryptotools/.cryptotools.env
ExecStart=/bin/bash /home/cryptotools/app/scripts/run_ranging_scan.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
