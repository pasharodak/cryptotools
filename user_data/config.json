{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 5,
    "tradable_balance_ratio": 0.95,
    "fiat_display_currency": "USD",
    "dry_run": false,
    "db_url": "sqlite:///tradesv3-freqai.sqlite",
    "cancel_open_orders_on_exit": true,
    "timeframe": "5m",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "minimal_roi": {
        "0": 0.03,
        "60": 0.015,
        "120": 0.005,
        "240": 0
    },
    "stoploss": -0.05,
    "trailing_stop": false,
    "use_exit_signal": true,
    "exit_profit_only": false,
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_exit": "market",
        "force_entry": "market",
        "stoploss": "market",
        "stoploss_on_exchange": true
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "recvWindow": 60000,
                "adjustForTimeDifference": true
            }
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "options": {
                "recvWindow": 60000,
                "adjustForTimeDifference": true
            }
        },
        "pair_whitelist": [
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "DOGE/USDT:USDT",
            "ADA/USDT:USDT",
            "SUI/USDT:USDT",
            "NEAR/USDT:USDT",
            "AVAX/USDT:USDT",
            "LINK/USDT:USDT",
            "BNB/USDT:USDT",
            "LTC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "telegram": {
        "enabled": true,
        "token": "",
        "chat_id": "",
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_fill": "on",
            "exit": "on",
            "exit_fill": "on"
        },
        "reload": true
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "",
        "username": "",
        "password": ""
    },
    "bot_name": "criptotools-freqai",
    "strategy": "FreqaiExampleStrategy",
    "freqaimodel": "LightGBMClassifier",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "freqai": {
        "enabled": true,
        "purge_old_models": 3,
        "train_period_days": 20,
        "backtest_period_days": 5,
        "live_retrain_hours": 6,
        "expiration_hours": 12,
        "identifier": "criptotools-bybit-classifier-v1",
        "feature_parameters": {
            "include_timeframes": ["5m", "15m", "1h", "4h"],
            "include_corr_pairlist": [
                "BTC/USDT:USDT",
                "ETH/USDT:USDT"
            ],
            "label_period_candles": 48,
            "include_shifted_candles": 2,
            "DI_threshold": 0.6,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [10, 20],
            "plot_feature_importances": 0
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "random_state": 42
        },
        "model_training_parameters": {
            "n_estimators": 800,
            "learning_rate": 0.05,
            "max_depth": 6
        }
    }
}
