{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": 5,
    "tradable_balance_ratio": 0.95,
    "fiat_display_currency": "USD",
    "dry_run": false,
    "db_url": "sqlite:///tradesv3-grid.sqlite",
    "cancel_open_orders_on_exit": true,
    "timeframe": "5m",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "position_adjustment_enable": true,
    "minimal_roi": {},
    "stoploss": -0.05,
    "trailing_stop": false,
    "use_exit_signal": true,
    "exit_profit_only": false,
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_exit": "market",
        "force_entry": "market",
        "stoploss": "market",
        "stoploss_on_exchange": true
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "recvWindow": 60000,
                "adjustForTimeDifference": true
            }
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "options": {
                "recvWindow": 60000,
                "adjustForTimeDifference": true
            }
        },
        "pair_whitelist": [
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "DOGE/USDT:USDT",
            "ADA/USDT:USDT",
            "SUI/USDT:USDT",
            "NEAR/USDT:USDT",
            "AVAX/USDT:USDT",
            "LINK/USDT:USDT",
            "BNB/USDT:USDT",
            "LTC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "telegram": {
        "enabled": false
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8082,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "",
        "username": "",
        "password": ""
    },
    "bot_name": "criptotools-grid",
    "strategy": "VolatilityGridStrategy",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}
